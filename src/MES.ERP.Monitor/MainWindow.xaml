<Window x:Class="MES.ERP.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MES.ERP.Monitor"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="MES Production Dashboard"
        Height="950"
        Width="1400">

    <Grid Background="#F3F6F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="260"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1F4E79">

            <Grid>

                <TextBlock Text="MES Production Dashboard"
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="25,0"/>

                <TextBlock Text="{Binding LastUpdated}"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,30,0"/>

            </Grid>

        </Border>

        <!-- Dashboard Cards -->
        <Grid Grid.Row="1"
              Margin="25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Total Lots -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Margin="10"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Total Lots"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalLots}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#1F4E79"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Completed -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Margin="10"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Completed"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding CompletedLots}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="Green"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Processing -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Margin="10"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Processing"
                       FontSize="18"
                       HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding ProcessingLots}"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="Orange"
                       HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Quality Hold -->
            <Border Grid.Column="3"
                    Background="White"
                    CornerRadius="10"
                    Margin="10"
                    Padding="20"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Quality Hold"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding QualityHoldLots}"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="Red"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Completion Rate -->
        <Grid Grid.Row="2"
              Margin="15, 5, 15, 5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Margin="8"
                    Padding="25"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Completion Rate"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding CompletionRate, StringFormat={}{0:F1}%}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="Green"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Margin="8"
                    Padding="25"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Quality Hold Rate"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding QualityHoldRate, StringFormat={}{0:F1}%}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="Red"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

            <!-- Active Lots -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Margin="8"
                    Padding="25"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="Active Lots"
                               FontSize="18"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding ActiveLots}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="Orange"
                               HorizontalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>

        <Grid Grid.Row="3"
              Margin="15, 5, 15, 5">

            <Grid.RowDefinitions>
                <RowDefinition Height="250"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="2.5*"/>

                <ColumnDefinition Width="1*"/>

            </Grid.ColumnDefinitions>


            <!-- Production Status Chart -->

            <Border Grid.Row="0"
                    Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Margin="0,0,15,15"
                    Padding="20">

                <StackPanel>

                    <TextBlock Text="Production Status"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>


                    <lvc:CartesianChart Series="{Binding ProductionStatusSeries}"
                                Height="170"/>

                </StackPanel>

            </Border>



            <!-- Lot Details -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="25">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>

                        <TextBlock Text="Selected Lot"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20"/>


                        <TextBlock Text="Lot Number"
                           FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedLot.LotNumber}"
                           FontSize="18"
                           Margin="0,0,0,15"/>


                        <TextBlock Text="Product ID"
                           FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedLot.ProductID}"
                           FontSize="18"
                           Margin="0,0,0,15"/>


                        <TextBlock Text="Quantity Completed"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedLot.QuantityCompleted}"
                                   FontSize="18"
                                   Margin="0,0,0,15"/>


                        <TextBlock Text="Status"
                                   FontWeight="Bold"/>

                        <TextBlock Text="{Binding SelectedLot.LotStatus}"
                                   FontSize="18"/>


                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>


        <!-- Production Lot Table -->
            <DataGrid Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Margin="0,15,0,0"
                      FontSize="15"
                      RowHeight="35"
                      ColumnWidth="*"
                      ColumnHeaderHeight="40"
                      ItemsSource="{Binding RecentLots}"
                      SelectedItem="{Binding SelectedLot}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column">


                <DataGrid.Columns>

                    <DataGridTextColumn Header="Lot ID"
                                        Binding="{Binding LotID}"/>

                    <DataGridTextColumn Header="Lot Number"
                                        Binding="{Binding LotNumber}"/>

                    <DataGridTextColumn Header="Product ID"
                                        Binding="{Binding ProductID}"/>

                    <DataGridTextColumn Header="Quantity"
                                        Binding="{Binding QuantityCompleted}"/>

                    <DataGridTextColumn Header="Status"
                                        Binding="{Binding LotStatus}"/>

                </DataGrid.Columns>


            </DataGrid>


    </Grid>

</Window>